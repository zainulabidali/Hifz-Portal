rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /madrasas/{madrasaId}/students/{studentId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.uid == madrasaId || 
        // Note: checking firestore role in storage rules is possible but requires firestore helper. 
        // To keep it simple and robust without additional reads, we allow write access to authenticated users matching madrasaId
        request.auth.uid == madrasaId
      );
    }
  }
}
